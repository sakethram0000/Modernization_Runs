@using ChecklistsModern.Extensions

@if (User.Identity?.IsAuthenticated == true)
{
    <form id="logoutForm" class="navbar-right" method="post" action="/Account/LogOff">
        <ul class="nav navbar-nav navbar-right">
            <li class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Hello @User.GetFullName()! <span class="caret"></span></a>
                <ul class="dropdown-menu">
                    <li>
                        <a href="/Manage/ChangePassword">Change Password</a>
                    </li>
                    <li role="separator" class="divider"></li>
                    <li><a href="javascript:document.getElementById('logoutForm').submit()">Log out</a></li>
                </ul>
            </li>
        </ul>
    </form>
}
else
{
    <ul class="nav navbar-nav navbar-right">
        <li><a href="/Account/Register" id="registerLink">Register</a></li>
        <li><a href="/Account/Login" id="loginLink">Log in</a></li>
    </ul>
}
